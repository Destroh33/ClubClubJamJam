  m_Script: {fileID: 11500000, guid: 0015aa22a66a572488311b54d5e502c0, type: 3}
  m_Name: Level2
  m_EditorClassIdentifier: Assembly-CSharp::LevelConfig
  levelName: making friends
  mainProgram: "    //In addition to being able to collect shells, our main crab
    has a special property:\n    //it can upload code to other crab-bots!\n    //
    use the upload command, and specify which file you want to select\n    //in order
    to upload to adjacent crabs\n    //you can edit the code of another file by just
    clicking on its tab\n    //ONLY the brain robot can pickup shells!\n\n    right(3);\n   
    upload(file1); //upload to heavy\n    right(7);\n    up(1);\n    upload(file2);
    //upload to dozer\n    right(1);\n    up(5);\n    pickup(); //get the shell that
    was gated before, but opened by the box on the button\n    down(3);\n    right(3);\n   
    up(3);\n    give(); //give the shell to the crab trapped behind the gate!"
  extraFiles: 2
  extraPrograms:
  - "    //dozers have the ability to break through spikes that would normally kill
    the brain crab\n    //use them to clear a path\n    right(10);"
  - "    //heavies can push boxes around, letting you trigger buttons\n    up(1);\n   
    right(3);\n    up(1);\n    down(1); //the fence only opens when something sits
    on it\n    up(1);"
  startSpeed: 1
  maxTicks: 30
  sceneName: Level2
  next: {fileID: 11400000, guid: f76db58a5bec43143be756cd421e097a, type: 2}
